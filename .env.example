# Required for auth + data (Postgres). Without these, sign-in/sign-up cannot work.
DATABASE_URL=
BETTER_AUTH_SECRET=            # generate: openssl rand -base64 32
BETTER_AUTH_URL=               # your deployed URL, e.g. https://twinforge-theta.vercel.app

# Optional — password-reset emails via Gmail SMTP (Nodemailer). Safe to leave blank.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# GPU worker (Anrui / RunPod TwinForge worker — NOT the Anrui gallery URL)
# Point these at the worker public URL from rc-tunnel / RunPod.
GPU_API_BASE_URL=              # e.g. https://rc-xxxx.radeon.firstdg.ai
GPU_API_KEY=                   # shared bearer token with the worker
GPU_WEBHOOK_SECRET=            # openssl rand -hex 32 (must match worker)
# Aliases used by Settings readiness checks (set to the same values):
GPU_API_URL=                   # same as GPU_API_BASE_URL
GPU_API_TOKEN=                 # same as GPU_API_KEY

# Blob storage (uploads/outputs)
BLOB_READ_WRITE_TOKEN=
